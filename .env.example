APP_NAME=ChaosLab
DATABASE_URL=sqlite:///./chaoslab.db

# 외부 시스템 (Slice 1 미사용)
K8S_CONTEXT=
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100

# AI (Phase 3)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
REPORT_LLM_MODEL=gpt-5.6-luna
REPORT_LLM_REASONING_EFFORT=low
TARGET_R=0.7

# ── Slice 2c: 실제 빌드/배포 연동 ──
# false(기본)=Stub → 로컬/테스트는 클러스터·AWS 없이 동작. EC2 운영 시 true.
USE_REAL_SERVICES=false
AWS_REGION=ap-northeast-2
# <account>.dkr.ecr.ap-northeast-2.amazonaws.com (terraform output ecr_registry)
ECR_REGISTRY=
IAC_AWS_REPO_URL=https://github.com/KuardianAngelRing/Iac-aws
# EC2 로컬 클론 경로 (예: /home/ec2-user/Iac-aws)
IAC_AWS_REPO_PATH=
# Iac-aws push용 (크로스레포 쓰기)
GITHUB_TOKEN=
ARGO_NAMESPACE=argo
SUT_NAMESPACE=sut
BUILD_WORKFLOW_TEMPLATE=build-and-push

# ── 로컬(라즈베리파이 k3s) 인프라 — 경로 설정 시 Real 조회, 비면 Stub ──
# SSH 터널 선행 필요: ssh -f -N -L 6443:localhost:6443 masternode (접속 정보는 팀 내 개인 전달)
# kubeconfig의 server는 https://127.0.0.1:6443 이어야 함
LOCAL_KUBECONFIG=
LOCAL_CLUSTER_NAME=chaospilot-k3s
LOCAL_OBS_NAMESPACE=chaospilot-observability
LOCAL_CHAOS_NAMESPACE=chaos-mesh
# SSH 터널 자동 관리 — 호스트 설정 시 기동할 때 앱이 터널을 열고 유지 (비면 수동 터널 전제)
# 접속 정보(호스트·포트·유저·키)는 팀 내 개인 전달, 커밋 금지
LOCAL_SSH_HOST=
LOCAL_SSH_PORT=22
LOCAL_SSH_USER=
LOCAL_SSH_KEY_PATH=
LOCAL_TUNNEL_PORT=6443
LOCAL_TUNNEL_TARGET=localhost:6443
